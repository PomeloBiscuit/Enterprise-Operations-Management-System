
# OS-specific files
.DS_Store
Thumbs.db

# IDE and editor folders
.vscode/
.idea/

# Backup files
*.bak
*.tmp
*.swp

# Database credentials or configs (if added)
config.inc.php

# SQLite 資料庫檔（由 create.php 產生，不進版控；保留目錄結構用 .gitkeep）
data/*
!data/.gitkeep

# Session 檔（舊版誤存進專案目錄，現已改用系統預設路徑）
sessionstmp/
sess_*

# Node modules (if used later)
node_modules/

# 內部作業文件（不對外公開，另行備份）
# 注意：內部文件放在 _ops/，不是 docs/ —— docs/ 保留給對外的 GitHub Pages 介紹頁。
CLAUDE.md
_ops/
新專案開場指令.md
